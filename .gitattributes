# Force LF line endings for all text files
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Markdown files
*.md text eol=lf

# YAML/JSON
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files — do not touch
*.zip binary
*.tar.gz binary
*.png binary
*.svg binary
